		"./package.json": "./package.json"
	},
	"scripts": {
		"lint": "biome check --write",
		"biome": "biome",
		"build": "bun run tsc --project tsconfig.build.json && bun run tsc-alias --project tsconfig.build.json"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@types/bun": "^1.4.0",
		"tsc-alias": "^1.9.4"
	},
	"peerDependencies": {
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"typescript": "^7.0.2"
	},
