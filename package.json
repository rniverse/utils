	"version": "0.0.1",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./env": {
			"types": "./dist/lib/utils/env.d.ts",
			"default": "./dist/lib/utils/env.js"
		},
